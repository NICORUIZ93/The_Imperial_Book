{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "aplicacion",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/*.css", "/*.js", "/media/**"]
      }
    },
    {
      "name": "indices",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/content/topic-index.json", "/content/curriculum-catalog.json", "/brands/**"]
      }
    },
    {
      "name": "libro",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/content/**", "/visuals/**", "/katex/**"]
      }
    }
  ]
}
